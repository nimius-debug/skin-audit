{
  "name": "skin-audit",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "db:schema": "wrangler d1 execute skin-audit-db --remote --file=schema.sql",
    "db:migrate": "wrangler d1 migrations apply skin-audit-db --remote",
    "tail": "wrangler tail"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}

